# =========================================================
# APP
# =========================================================
NODE_ENV=development
PORT=8000
TRUST_PROXY=false
ENABLE_SWAGGER=false

# =========================================================
# DATABASE
# =========================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
DB_MAX_POOL_SIZE=200
CLUSTER_MODE=false

# =========================================================
# JWT AUTHENTICATION & SECURITY
# =========================================================
JWT_ACCESS_SECRET=<replace-with-64-byte-hex-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=<replace-with-different-64-byte-hex-secret>
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=cafemart-api
JWT_AUDIENCE=cafemart-client
BCRYPT_COST=12

# =========================================================
# GOOGLE & APPLE OAUTH
# =========================================================
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
APPLE_CLIENT_ID=<apple-service-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>

# =========================================================
# URLS & CORS
# =========================================================
CLIENT_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com,https://admin.example.com
API_BASE_URL=https://api.example.com/api/v1
SERVER_URL=https://api.example.com

# =========================================================
# REDIS (HYBRID UPSTASH REST + NATIVE TCP ARCHITECTURE)
# =========================================================
# 1) Upstash Redis REST API (from Upstash Console -> REST API tab)
# Used for stateless HTTP commands, caching, rate limiting, and session checks.
# REST URL & token CANNOT power Socket.IO Redis Adapter Pub/Sub.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2) Native TCP Redis URL (from Upstash Console -> Connect -> Node.js / ioredis)
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
# REQUIRED for multi-instance Socket.IO (@socket.io/redis-adapter) and Pub/Sub revocation.
# Note: REDIS_URL is canonical (UPSTASH_REDIS_URL is also accepted as an alias fallback).
REDIS_URL=

# 3) Optional discrete TCP overrides & tuning (only uncomment for local dev Redis without REDIS_URL)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_REVOCATION_FAIL_CLOSED=true
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_REST_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=2

# =========================================================
# SOCKET.IO
# =========================================================
# Comma-separated transports: websocket,polling
# Note: If polling is enabled behind a load balancer, configure sticky sessions (affinity).
SOCKET_TRANSPORTS=websocket,polling
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_CONNECTIONS_PER_USER=25

# =========================================================
# CLOUDINARY
# =========================================================
CLOUDINARY_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# =========================================================
# CASHFREE PAYMENTS
# =========================================================
CASHFREE_APP_ID=<cashfree-app-id>
CASHFREE_SECRET_KEY=<cashfree-secret-key>
CASHFREE_ENV=SANDBOX

# =========================================================
# ADMIN BOOTSTRAP
# =========================================================
ADMIN_REGISTER_SECRET=<replace-with-high-entropy-secret-min-16-chars>
ALLOW_ADMIN_REGISTRATION=true

# =========================================================
# FIREBASE ADMIN SDK
# =========================================================
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
